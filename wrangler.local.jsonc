{
  "name": "nfl-picks-local",
  "compatibility_date": "2026-10-21",
  "main": "worker.js",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "build": {
    "command": "npm run build"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nfl-picks-local",
      "database_id": "nfl-picks-local"
    }
  ]
}
